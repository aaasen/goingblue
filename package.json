{
  "name": "weather",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@shopify/react-native-skia",
      "esbuild"
    ],
    "overrides": {
      "@babel/core": "7.29.7"
    }
  },
  "scripts": {
    "build": "pnpm --filter @weather/protocol build && pnpm --filter @weather/server build && pnpm --filter @weather/codec-server build",
    "start": "pnpm build && node packages/server/dist/index.js",
    "start:codec": "pnpm build && node packages/codec-server/dist/index.js",
    "test": "pnpm --filter @weather/protocol test && pnpm --filter @weather/server test && pnpm --filter @weather/codec-server test && pnpm --filter @weather/mobile test",
    "benchmark": "pnpm --filter @weather/protocol build && tsx packages/codec-server/scripts/benchmark.ts",
    "corpus-map": "tsx packages/codec-server/scripts/corpus-map.ts",
    "avalanche-collect": "tsx packages/codec-server/scripts/avalanche/collect.ts",
    "avalanche-benchmark": "tsx packages/codec-server/scripts/avalanche/benchmark.ts",
    "avalanche-explore": "tsx packages/codec-server/scripts/avalanche/explore.ts",
    "avalanche-export": "tsx packages/codec-server/scripts/avalanche/export.ts",
    "avalanche-model": "tsx packages/codec-server/scripts/avalanche/write-model.ts",
    "avalanche-pieces": "tsx packages/codec-server/scripts/avalanche/pieces.ts",
    "avalanche-region": "tsx packages/codec-server/scripts/avalanche/region.ts",
    "generate": "pnpm --filter @weather/protocol build && tsx packages/codec-server/scripts/generate-codebooks.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.11"
  }
}
