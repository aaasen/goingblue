# The codec-server image: one build per shipped protocol version, created from that version's
# `codec-vN` git tag and deployed as its own Cloud Run service (see VERSIONING.md). It is
# protocol + codec-server only — no Expo/Metro toolchain — so a frozen version stays cheap to
# rebuild bit-identically when a base-image CVE or upstream change forces it (verify with
# packages/codec-server: verify-container against the golden corpus).
FROM node:26-slim AS base
WORKDIR /app
# Node 26 no longer bundles corepack, so it is installed here; the pnpm version itself still
# comes from the root package.json "packageManager" field.
RUN npm i -g corepack@latest && corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/protocol/package.json packages/protocol/
COPY packages/codec-server/package.json packages/codec-server/
# Every workspace manifest must exist for the frozen-lockfile check, including packages this
# image never builds; the filter keeps the install to codec-server and its workspace dependencies.
COPY packages/server/package.json packages/server/
COPY packages/mobile/package.json packages/mobile/

FROM base AS build
RUN pnpm install --frozen-lockfile --filter "@weather/codec-server..."
COPY tsconfig.base.json ./
COPY packages/protocol packages/protocol
COPY packages/codec-server packages/codec-server
# Models are not in git; this downloads the ones the checkout pins, so a codec-vN rebuild gets
# exactly its own.
RUN node packages/protocol/scripts/fetch-models.mjs
RUN pnpm --filter @weather/protocol build \
 && pnpm --filter @weather/codec-server build

FROM base
ENV NODE_ENV=production
RUN pnpm install --frozen-lockfile --prod --filter "@weather/codec-server..."
COPY --from=build /app/packages/protocol/dist packages/protocol/dist
COPY --from=build /app/packages/protocol/assets packages/protocol/assets
COPY --from=build /app/packages/codec-server/dist packages/codec-server/dist
USER node
CMD ["node", "packages/codec-server/dist/index.js"]
