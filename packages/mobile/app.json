{
  "expo": {
    "name": "Going Blue",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.laneaasen.weather",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Used to fetch a weather forecast for your current position."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#9ccdf0",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_ANDROID_MAPS_SDK_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "baseUrl": "/app"
    },
    "extra": {
      "eas": {
        "projectId": "d7df179b-5e9e-4cce-8b42-27288a8f1298"
      }
    },
    "owner": "laneaasen"
  }
}
