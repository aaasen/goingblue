{
  "expo": {
    "name": "Going Blue",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.laneaasen.weather",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#9ccdf0",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAeWPCtMKfyGTO2U5NjrfZJeehyS9Iu8KI"
        }
      },
      "package": "com.laneaasen.weather"
    },
    "extra": {
      "eas": {
        "projectId": "d7df179b-5e9e-4cce-8b42-27288a8f1298"
      }
    },
    "owner": "laneaasen",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 147,
          "resizeMode": "contain",
          "backgroundColor": "#f2f2f7"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Going Blue uses your location to fetch a forecast for where you are. You can also pick a location on the map instead.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "Used to improve the accuracy of your current location when fetching a forecast."
        }
      ],
      "expo-status-bar"
    ]
  }
}
